@model List<AgentPortalWeb.Models.Item>
@{
    ViewData["Title"] = "Wholesale Catalog & Bulk Order";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-primary mb-0"><i class="bi bi-cart4 me-2"></i>Wholesale Catalog & Bulk Order</h3>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Thanh tìm kiếm sản phẩm -->
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search product name..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Form đặt hàng Master-Detail -->
<form asp-controller="Catalog" asp-action="PlaceOrder" method="post">
    @Html.AntiForgeryToken()

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-1">
                        <i class="bi bi-building text-primary me-1"></i>Select Ordering Agent:
                    </label>
                    <select name="agentId" asp-items="ViewBag.Agents" class="form-select border-primary" required>
                        <option value="">-- Choose Distributor Agent --</option>
                    </select>
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <span class="text-muted d-block small">Estimated Order Total</span>
                    <h4 class="fw-bold text-success mb-0" id="lblEstimatedTotal">0 VND</h4>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">#ID</th>
                            <th>Product Name</th>
                            <th>Size / Pack</th>
                            <th class="text-end">Unit Price (VND)</th>
                            <th class="text-center">Available Stock</th>
                            <th style="width: 160px;" class="text-center pe-3">Order Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td class="ps-3 text-muted">@Model[i].ItemID</td>
                                <td class="fw-semibold">@Model[i].ItemName</td>
                                <td><span class="badge bg-secondary">@Model[i].Size</span></td>
                                <td class="text-end fw-semibold">@Model[i].Price.ToString("N0")</td>
                                <td class="text-center">
                                    @if (Model[i].StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger">Out of Stock (0)</span>
                                    }
                                    else if (Model[i].StockQuantity <= 10)
                                    {
                                        <span class="badge bg-warning text-dark">Low: @Model[i].StockQuantity</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@Model[i].StockQuantity</span>
                                    }
                                </td>
                                <td class="pe-3">
                                    <input type="hidden" name="items[@i].ItemID" value="@Model[i].ItemID" />
                                    <input type="number"
                                           name="items[@i].Quantity"
                                           value="0"
                                           min="0"
                                           max="@Model[i].StockQuantity"
                                           data-price="@Model[i].Price"
                                           class="form-control text-center qty-input"
                                    @(Model[i].StockQuantity == 0 ? "disabled" : "") />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white py-3 d-flex justify-content-end">
            <button type="submit" class="btn btn-success btn-lg px-4 fw-bold">
                <i class="bi bi-bag-check-fill me-2"></i>Place Bulk Order
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.querySelectorAll('.qty-input').forEach(input => {
            input.addEventListener('input', calculateTotal);
        });

        function calculateTotal() {
            let total = 0;
            document.querySelectorAll('.qty-input').forEach(input => {
                const qty = parseInt(input.value) || 0;
                const price = parseFloat(input.getAttribute('data-price')) || 0;
                if (qty > 0) {
                    total += qty * price;
                }
            });
            document.getElementById('lblEstimatedTotal').innerText = total.toLocaleString('en-US') + ' VND';
        }
    </script>
}